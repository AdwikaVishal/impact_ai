# MarketShield AI - Environment Variables Template
# Copy this file to backend/.env and fill in your actual API keys

# =============================================================================
# REQUIRED API KEYS - Get these for full functionality
# =============================================================================

# Groq API (REQUIRED - for LLM-based analysis and intelligence)
# Get your free API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NewsAPI (REQUIRED - for fetching live market news)
# Get your free API key from: https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# Alpha Vantage (REQUIRED - for stock market data)
# Get your free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# =============================================================================
# OPTIONAL API KEYS - Enhanced features
# =============================================================================

# Serper API (OPTIONAL - for enhanced search and LinkedIn data)
# Get from: https://serper.dev
SERPER_KEY=your_serper_key_here

# Hunter API (OPTIONAL - for email verification and validation)
# Get from: https://hunter.io
HUNTER_API_KEY=your_hunter_api_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/marketshield

# Redis URL (for caching and background tasks)
REDIS_URL=redis://localhost:6379

# =============================================================================
# MACHINE LEARNING & AI
# =============================================================================

# Ollama URL (for local LLM inference - optional)
OLLAMA_URL=http://localhost:11434

# Hugging Face cache directory (for ML models)
HF_CACHE_DIR=./models

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# Secret key for JWT token generation (change this in production!)
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment mode (development, staging, production)
ENVIRONMENT=development

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# =============================================================================
# LOGGING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO